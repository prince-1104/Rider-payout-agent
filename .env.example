# PostgreSQL connection. Plain postgresql:// URLs are normalised to the psycopg v3 driver.
DATABASE_URL=postgresql+psycopg://quickdrop:quickdrop@localhost:5432/quickdrop

# PaySwift sandbox base URL (used from Phase 2 onwards).
PAYSWIFT_BASE_URL=http://localhost:8081

# Optional structured LangChain chat model for the bounded message workflow.
# Leave unset to safely queue messages for operations review.
# LLM_MODEL=your-model-name
# LLM_API_KEY=your-api-key
# LLM_BASE_URL=https://api.example.com/v1
# LLM_TIMEOUT_SECONDS=2.0

# Logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Optional: run the test suite against Postgres instead of in-memory SQLite.
# TEST_DATABASE_URL=postgresql+psycopg://quickdrop:quickdrop@localhost:5432/quickdrop_test
